# =============================================================================
# Production Environment Variables
# =============================================================================
# Copy ke .env.local untuk development production, atau set sebagai GitHub Variables
# di Repository Settings → Environments → production
# =============================================================================

# URL bucket/file storage (untuk foto, dokumen, attachment)
NEXT_PUBLIC_FILE_URL=https://bucket.okejobhub.fun

# Base URL API utama
NEXT_PUBLIC_BASE_URL=https://api.okejobhub.fun/api/v1

# Base URL API face recognition
NEXT_PUBLIC_BASE_URL_RECOGNITION=https://face.okejobhub.fun/api/v1

# Base URL API employee
NEXT_PUBLIC_BASE_URL_EMPLOYEE=https://api.okejobhub.fun/api
