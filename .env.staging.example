# =============================================================================
# Staging Environment Variables
# =============================================================================
# Copy ke .env.local untuk development staging, atau set sebagai GitHub Variables
# di Repository Settings → Environments → staging
# =============================================================================

# URL bucket/file storage (untuk foto, dokumen, attachment)
NEXT_PUBLIC_FILE_URL=https://bucket-staging.okejobhub.fun

# Base URL API utama
NEXT_PUBLIC_BASE_URL=https://api-staging.okejobhub.fun/api/v1

# Base URL API face recognition
NEXT_PUBLIC_BASE_URL_RECOGNITION=https://face-staging.okejobhub.fun/api/v1

# Base URL API employee
NEXT_PUBLIC_BASE_URL_EMPLOYEE=https://api-staging.okejobhub.fun/api

# Optional: ESS custom-scheme base used by /app/reset-password bridge (default hrms-app://com.okjob.hrms)
# NEXT_PUBLIC_MOBILE_DEEP_LINK_URL=hrms-app://com.okjob.hrms
